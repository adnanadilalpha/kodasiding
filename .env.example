NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
# Required to create/update/delete admin accounts from Admins
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# AES-256-GCM key for encrypting SMTP passwords at rest (32+ bytes; use a long random secret)
SMTP_SECRET_KEY=replace-with-a-long-random-secret-at-least-32-chars

# Google reCAPTCHA v3 (https://www.google.com/recaptcha/admin) — required in production
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=your-recaptcha-site-key
RECAPTCHA_SECRET_KEY=your-recaptcha-secret-key

# Google Analytics 4 (https://analytics.google.com)
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
